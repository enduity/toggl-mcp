{
  "name": "toggl-mcp",
  "version": "0.1.0",
  "description": "MCP server for Toggl Track day-fill: list entries/projects, bulk add/edit, delete",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "toggl-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "toggl",
    "time-tracking"
  ],
  "license": "MIT",
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "msw": "^2.12.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
